---
import '../styles/globals.css';
import '@fontsource-variable/inter/wght.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
        <meta name="description" content="Eco City — Smart sustainable communities. Report issues, access services, and connect with your town." />
        <meta name="theme-color" content="#22c55e" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <meta name="apple-mobile-web-app-title" content="Eco City" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
        <link rel="manifest" href="/manifest.json" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    </head>
    <body class="antialiased">
        <div id="app"><slot /></div>
        <script>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js').catch(() => {});
                });
            }

            // Install prompt
            let deferredPrompt: any;
            window.addEventListener('beforeinstallprompt', (e: any) => {
                e.preventDefault();
                deferredPrompt = e;
                const dismissed = localStorage.getItem('ecocity_install_dismissed');
                const sevenDays = 7 * 24 * 60 * 60 * 1000;
                if (dismissed && (Date.now() - parseInt(dismissed)) < sevenDays) return;
                setTimeout(() => {
                    if (deferredPrompt && !document.getElementById('install-banner')) {
                        const banner = document.createElement('div');
                        banner.id = 'install-banner';
                        banner.innerHTML = `
                            <div style="position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#1e293b;color:white;padding:14px 18px;border-radius:14px;display:flex;align-items:center;gap:12px;z-index:9999;box-shadow:0 8px 30px rgba(0,0,0,0.4);width:calc(100% - 40px);max-width:380px;border:1px solid rgba(255,255,255,0.1);">
                                <div style="width:36px;height:36px;background:#22c55e;border-radius:9px;display:flex;align-items:center;justify-content:center;shrink:0;flex-shrink:0;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 2L8 8H16L12 2Z"/><path d="M12 22V8"/><rect x="3" y="18" width="18" height="4" rx="2"/></svg>
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <p style="font-weight:700;font-size:13px;margin:0;letter-spacing:-0.2px;">Install Eco City</p>
                                    <p style="font-size:11px;opacity:0.6;margin:2px 0 0;">Add to home screen for quick access</p>
                                </div>
                                <button id="install-btn" style="background:#22c55e;color:white;border:none;padding:7px 14px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;">Install</button>
                                <button id="dismiss-btn" style="background:rgba(255,255,255,0.1);color:white;border:none;width:28px;height:28px;border-radius:6px;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;">&times;</button>
                            </div>
                        `;
                        document.body.appendChild(banner);
                        document.getElementById('install-btn')?.addEventListener('click', () => {
                            deferredPrompt.prompt();
                            deferredPrompt.userChoice.then(() => { deferredPrompt = null; });
                            banner.remove();
                        });
                        document.getElementById('dismiss-btn')?.addEventListener('click', () => {
                            localStorage.setItem('ecocity_install_dismissed', Date.now().toString());
                            banner.remove();
                        });
                    }
                }, 4000);
            });
        </script>
    </body>
</html>
