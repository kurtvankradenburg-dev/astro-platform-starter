---
import '../styles/globals.css';
import '@fontsource-variable/inter/wght.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
    title: string;
    description?: string;
    noWrapper?: boolean;
}

const { title, description = 'Science-based lifting and human performance analysis platform', noWrapper = false } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title} | Myogen</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    </head>
    <body>
        {noWrapper ? (
            <slot />
        ) : (
            <div class="min-h-screen flex flex-col">
                <slot />
            </div>
        )}
    </body>
</html>
