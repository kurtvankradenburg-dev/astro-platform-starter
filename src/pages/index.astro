---
import Layout from '../layouts/Layout.astro';
import Markdown from '../components/Markdown.astro';

const explainer = `
Welcome to **EcoCityNet** — your community platform for Upington and the Northern Cape.

Explore local **job opportunities** in our Job Center, ask our **AI Assistant** about the history, culture, weather, and attractions of Upington, or explore the platform features built on Netlify's powerful infrastructure.

EcoCityNet connects residents and visitors with the resources they need — from employment to local knowledge.
`;
---

<Layout title="EcoCityNet - Upington Community Platform">
    <h1 class="mb-10">Welcome to EcoCityNet</h1>
    <Markdown content={explainer} class="mb-10 text-lg" />

    <div class="grid gap-6 sm:grid-cols-2 mb-12">
        <a href="/jobs" class="block bg-gray-800/50 border border-gray-700 rounded-lg p-6 no-underline hover:border-primary/50 transition-colors group">
            <h2 class="text-xl font-bold text-primary mb-2 group-hover:underline">Job Center</h2>
            <p class="text-gray-300 text-sm">Browse available positions in Upington — from mechanics and electricians to teachers and nurses.</p>
        </a>
        <a href="/ai-assistant" class="block bg-gray-800/50 border border-gray-700 rounded-lg p-6 no-underline hover:border-primary/50 transition-colors group">
            <h2 class="text-xl font-bold text-primary mb-2 group-hover:underline">AI Assistant</h2>
            <p class="text-gray-300 text-sm">Ask questions about Upington's history, weather, attractions, economy, and more.</p>
        </a>
    </div>

    <p>
        <a href="https://docs.netlify.com/frameworks/astro/" class="btn btn-lg sm:min-w-64">Explore the Platform</a>
    </p>
</Layout>
